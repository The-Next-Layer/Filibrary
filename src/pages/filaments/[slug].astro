---
import Layout from '../../layouts/Layout.astro';
import { filaments } from '../../data/filaments';

export function getStaticPaths() {
  return filaments.map((f) => ({ params: { slug: f.slug }, props: { filament: f } }));
}

const { filament: f } = Astro.props;

function tagClass(tag: string) {
  return 'tag tag-' + tag.replace(/\s+/g, '-').replace(/\//g, '-');
}

function withUTM(url: string, slug: string, label: string): string {
  if (!url) return url;
  try {
    const u = new URL(url);
    u.searchParams.set('utm_source', 'filibrary');
    u.searchParams.set('utm_medium', 'referral');
    u.searchParams.set('utm_campaign', slug);
    const content = label.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, '');
    if (content) u.searchParams.set('utm_content', content);
    return u.toString();
  } catch {
    return url;
  }
}

const shareUrl = new URL(`/filaments/${f.slug}`, Astro.site ?? 'https://filibrary.thenextlayer.com').toString();
const shareText = `${f.shortName} — ${f.fullName} on Filibrary`;

// Build radar SVG server-side
function buildRadar(stats: { label: string; value: number }[]) {
  if (!stats || stats.length === 0) return '';
  const size = 420, cx = size / 2, cy = size / 2, r = 110;
  const n = stats.length;
  const angleFor = (i: number) => (Math.PI * 2 * i / n) - Math.PI / 2;

  let rings = '';
  [0.25, 0.5, 0.75, 1].forEach((factor) => {
    const pts: string[] = [];
    for (let i = 0; i < n; i++) {
      const a = angleFor(i);
      pts.push(`${(cx + r * factor * Math.cos(a)).toFixed(1)},${(cy + r * factor * Math.sin(a)).toFixed(1)}`);
    }
    const cls = factor === 1 ? 'radar-ring radar-ring-outer' : 'radar-ring';
    rings += `<polygon points="${pts.join(' ')}" class="${cls}" />`;
  });

  let axes = '';
  for (let i = 0; i < n; i++) {
    const a = angleFor(i);
    axes += `<line x1="${cx}" y1="${cy}" x2="${(cx + r * Math.cos(a)).toFixed(1)}" y2="${(cy + r * Math.sin(a)).toFixed(1)}" class="radar-axis" />`;
  }

  const dataPts: string[] = [];
  let dots = '';
  for (let i = 0; i < n; i++) {
    const a = angleFor(i);
    const val = Math.max(0, Math.min(100, stats[i].value || 0));
    const rr = r * (val / 100);
    const px = cx + rr * Math.cos(a);
    const py = cy + rr * Math.sin(a);
    dataPts.push(`${px.toFixed(1)},${py.toFixed(1)}`);
    dots += `<circle cx="${px.toFixed(1)}" cy="${py.toFixed(1)}" r="3.5" class="radar-dot" />`;
  }

  let labels = '';
  for (let i = 0; i < n; i++) {
    const a = angleFor(i);
    const lx = cx + (r + 26) * Math.cos(a);
    const ly = cy + (r + 26) * Math.sin(a);
    let anchor = 'middle';
    if (Math.cos(a) > 0.35) anchor = 'start';
    else if (Math.cos(a) < -0.35) anchor = 'end';
    labels += `<text x="${lx.toFixed(1)}" y="${ly.toFixed(1)}" class="radar-label" text-anchor="${anchor}" dominant-baseline="middle">${stats[i].label}</text>`;
    labels += `<text x="${lx.toFixed(1)}" y="${(ly + 14).toFixed(1)}" class="radar-value" text-anchor="${anchor}" dominant-baseline="middle">${stats[i].value}</text>`;
  }

  return `<div class="radar-wrap"><svg viewBox="0 0 ${size} ${size}" class="radar" role="img" aria-label="Filament performance radar">${rings}${axes}<polygon points="${dataPts.join(' ')}" class="radar-data" />${dots}${labels}</svg></div>`;
}

const radarHtml = buildRadar(f.stats || []);

const related = filaments
  .filter((r) => r.slug !== f.slug && r.tags.some((t) => f.tags.includes(t)))
  .slice(0, 4);

const PAYPAL_URL = 'https://www.paypal.com/donate/?business=partnerships@thenextlayer.com&no_recurring=0&item_name=Support+Filibrary+%E2%80%94+the+3D+printer+filament+library&currency_code=USD';
---

<Layout title={`${f.shortName} — ${f.fullName}`} description={f.summary}>

  <div class="crumb-bar">
    <div class="container">
      <a href="/">← Back to Library</a>
    </div>
  </div>

  <div class="detail-page">
    <div class="container">

      <header class="detail-header">
        <div class="detail-title-row">
          <span class="detail-short">{f.shortName}</span>
          <div class="detail-tags">
            {f.tags.map((tag) => <span class={tagClass(tag)}>{tag}</span>)}
          </div>
        </div>
        <h1 class="detail-full">{f.fullName}</h1>
        <p class="detail-summary">{f.summary}</p>
      </header>

      <div class="detail-grid">
        <div class="detail-main">

          {f.heroImageUrl && (
            <figure class="detail-hero">
              <img src={f.heroImageUrl} alt={`Sample print in ${f.shortName}`} loading="lazy" />
              {f.heroImageCreditLabel && (
                <figcaption class="detail-hero-credit">
                  Image courtesy of{' '}
                  {f.heroImageCreditUrl ? (
                    <a href={f.heroImageCreditUrl} target="_blank" rel="noopener noreferrer">{f.heroImageCreditLabel}</a>
                  ) : (
                    <span>{f.heroImageCreditLabel}</span>
                  )}
                </figcaption>
              )}
            </figure>
          )}

          {f.stats && f.stats.length > 0 ? (
            <section class="detail-section">
              <h2>Performance</h2>
              <div set:html={radarHtml} />
              {f.statsSource && (
                <p class="stat-source">Source: {f.statsSource}</p>
              )}
            </section>
          ) : (
            <section class="detail-section stats-empty">
              <h2>Performance</h2>
              <p>Detailed ratings for this material aren't available yet. <button class="link-btn" type="button" data-suggest={f.slug} data-suggest-tab="stats">Suggest ratings</button>.</p>
            </section>
          )}

          <section class="detail-report-row">
            <button class="suggest-link" type="button" data-suggest={f.slug} data-suggest-tab="vendor">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              Suggest an edit
            </button>
            <button class="report-btn" type="button" data-slug={f.slug}>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
              Report an issue
            </button>
          </section>

          {f.videoReferences && f.videoReferences.length > 0 && (
            <section class="detail-section">
              <h2>Referenced In</h2>
              <div class="video-grid">
                {f.videoReferences.map((v) => (
                  <a href={v.url} target="_blank" rel="noopener noreferrer" class="video-card">
                    <div class="video-thumb">
                      <img src={v.thumbnailUrl} alt={v.title} loading="lazy" />
                      <span class="video-play">▶</span>
                    </div>
                    <p class="video-title">{v.title}</p>
                  </a>
                ))}
              </div>
            </section>
          )}

        </div>

        <aside class="detail-aside">

          <div class="aside-card buy-card">
            <h2>Where to Buy</h2>
            {f.purchaseLinks && f.purchaseLinks.length > 0 ? (
              <div class="buy-list">
                {f.purchaseLinks.map((link) => (
                  <a href={withUTM(link.url, f.slug, link.label)} target="_blank" rel="noopener noreferrer sponsored" class="btn-buy">
                    <span>{link.label}</span>
                    <span class="btn-buy-arrow">→</span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="no-links">No purchase links yet. <button class="link-btn" type="button" data-suggest={f.slug} data-suggest-tab="vendor">Suggest a vendor</button>.</p>
            )}
          </div>

          <div class="aside-card share-card">
            <h2>Share</h2>
            <p class="share-text">Help other makers find this filament.</p>
            <button
              type="button"
              class="btn-share"
              data-share-url={shareUrl}
              data-share-text={shareText}
            >
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
              <span class="btn-share-label">Share filament</span>
            </button>
            <div class="share-socials">
              <a class="share-icon" target="_blank" rel="noopener noreferrer" title="Share on X" aria-label="Share on X"
                 href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`}>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a class="share-icon" target="_blank" rel="noopener noreferrer" title="Share on Reddit" aria-label="Share on Reddit"
                 href={`https://www.reddit.com/submit?url=${encodeURIComponent(shareUrl)}&title=${encodeURIComponent(shareText)}`}>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M22 12.07a2.16 2.16 0 0 0-3.66-1.55 10.7 10.7 0 0 0-5.74-1.81l1-4.6 3.2.7a1.54 1.54 0 1 0 .15-.92l-3.55-.78a.46.46 0 0 0-.55.36l-1.1 5.24a10.7 10.7 0 0 0-5.83 1.81 2.16 2.16 0 1 0-2.36 3.51 4.27 4.27 0 0 0-.05.66c0 3.34 3.89 6.05 8.69 6.05s8.69-2.71 8.69-6.05a4.27 4.27 0 0 0-.05-.66 2.17 2.17 0 0 0 1.16-1.96zM7 13.5a1.5 1.5 0 1 1 1.5 1.5A1.5 1.5 0 0 1 7 13.5zm8.71 4.04A5.66 5.66 0 0 1 12 18.62a5.66 5.66 0 0 1-3.71-1.08.4.4 0 1 1 .47-.65 4.92 4.92 0 0 0 3.24.91 4.92 4.92 0 0 0 3.24-.91.4.4 0 1 1 .47.65zM15.5 15a1.5 1.5 0 1 1 1.5-1.5 1.5 1.5 0 0 1-1.5 1.5z"/></svg>
              </a>
              <a class="share-icon" target="_blank" rel="noopener noreferrer" title="Share on Facebook" aria-label="Share on Facebook"
                 href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>
              </a>
              <a class="share-icon" target="_blank" rel="noopener noreferrer" title="Share via Email" aria-label="Share via Email"
                 href={`mailto:?subject=${encodeURIComponent(shareText)}&body=${encodeURIComponent(shareUrl)}`}>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </a>
            </div>
            <span class="share-toast" aria-live="polite"></span>
          </div>

          <div class="aside-card support-card">
            <p class="support-heading">Find Filibrary useful?</p>
            <p class="support-text">This library is free. A small donation keeps it running.</p>
            <a href={PAYPAL_URL} target="_blank" rel="noopener noreferrer" class="btn-paypal">
              Donate via PayPal
            </a>
          </div>

          {related.length > 0 && (
            <div class="aside-card related-card">
              <h3>Related Materials</h3>
              <ul class="related-inline-list">
                {related.map((r) => (
                  <li>
                    <a href={`/filaments/${r.slug}`} class="related-inline-link">
                      <span class="related-short">{r.shortName}</span>
                      <span class="related-full">{r.fullName}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </aside>
      </div>

    </div>
  </div>

  <script>
    const shareBtn = document.querySelector<HTMLButtonElement>('.btn-share');
    const toast = document.querySelector<HTMLElement>('.share-toast');
    const showToast = (msg: string) => {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('visible');
      window.setTimeout(() => toast.classList.remove('visible'), 1800);
    };
    shareBtn?.addEventListener('click', async () => {
      const url = shareBtn.dataset.shareUrl || window.location.href;
      const text = shareBtn.dataset.shareText || document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title: text, text, url });
          return;
        } catch (err) {
          if ((err as DOMException)?.name === 'AbortError') return;
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        showToast('Link copied!');
      } catch {
        showToast('Press Ctrl+C to copy');
      }
    });
  </script>

</Layout>

<style>
  .crumb-bar { background: var(--bg-elevated); border-bottom: 1px solid var(--border); padding: 0.7rem 0; }
  .crumb-bar a { font-size: 0.85rem; color: var(--text-muted); transition: color 0.15s; }
  .crumb-bar a:hover { color: var(--accent); }

  .detail-page { padding: 2.5rem 0 4rem; }

  .detail-header { margin-bottom: 2.5rem; }
  .detail-title-row { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
  .detail-short {
    font-size: 1.1rem; font-weight: 900; color: var(--accent);
    background: var(--accent-soft); border: 1.5px solid rgba(249,115,22,0.28);
    padding: 0.2rem 0.75rem; border-radius: 8px;
  }
  .detail-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .detail-full { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: var(--text); margin-bottom: 1rem; }
  .detail-summary { font-size: 1.05rem; color: var(--text-muted); line-height: 1.7; max-width: 680px; }

  .detail-grid { display: grid; grid-template-columns: 1fr 320px; gap: 1.75rem; align-items: start; }
  @media (max-width: 860px) { .detail-grid { grid-template-columns: 1fr; } .detail-aside { order: -1; } }

  .detail-section { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 1.5rem; margin-bottom: 1.25rem; }
  .detail-section h2 { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-dim); margin-bottom: 1.1rem; }

  .detail-aside { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 110px; }
  .aside-card { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 1.25rem; }
  .aside-card h2, .aside-card h3 { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-dim); margin-bottom: 1rem; }

  .support-card { background: var(--accent-soft); border-color: rgba(249,115,22,0.28); }
  .support-heading { font-size: 0.95rem; font-weight: 700; color: var(--accent); margin-bottom: 0.4rem; text-transform: none; letter-spacing: 0; }
  .support-text { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.9rem; }
  .support-card .btn-paypal { align-self: flex-start; }

  .related-inline-list { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }
  .related-inline-link {
    display: flex; gap: 0.65rem; align-items: baseline; padding: 0.5rem 0.1rem;
    border-bottom: 1px solid var(--border);
  }
  .related-inline-list li:last-child .related-inline-link { border-bottom: none; }
  .related-inline-link:hover .related-short { color: var(--accent-dark); }

  .detail-report-row { display: flex; justify-content: flex-end; gap: 0.25rem; margin: -0.5rem 0 1rem; flex-wrap: wrap; }
  .link-btn { background: none; border: none; color: var(--accent); font-weight: 600; cursor: pointer; font-size: inherit; font-family: inherit; padding: 0; }
  .link-btn:hover { text-decoration: underline; }

  .detail-hero {
    margin-bottom: 1.25rem; border-radius: var(--radius); overflow: hidden;
    border: 1.5px solid var(--border); background: var(--surface);
  }
  .detail-hero img { width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; object-fit: cover; }
  .detail-hero-credit { font-size: 0.75rem; color: var(--text-dim); padding: 0.5rem 0.85rem; background: var(--surface-alt); }
  .detail-hero-credit a { color: var(--text-muted); text-decoration: underline; }
  .detail-hero-credit a:hover { color: var(--accent); }

  .share-card .share-text { font-size: 0.85rem; color: var(--text-muted); margin: -0.4rem 0 0.85rem; }
  .btn-share {
    display: inline-flex; align-items: center; gap: 0.5rem; width: 100%; justify-content: center;
    background: var(--accent); color: #fff; font-size: 0.875rem; font-weight: 600;
    padding: 0.6rem 1rem; border-radius: 10px; border: none; cursor: pointer;
    font-family: inherit; transition: background 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .btn-share:hover { background: var(--accent-dark); transform: translateY(-1px); box-shadow: 0 6px 16px rgba(249,115,22,0.28); }
  .share-socials { display: flex; gap: 0.4rem; justify-content: center; margin-top: 0.7rem; }
  .share-icon {
    width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
    border-radius: 8px; background: var(--surface-alt); color: var(--text-muted);
    border: 1px solid var(--border); transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .share-icon:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .share-toast {
    display: block; text-align: center; font-size: 0.78rem; color: #15803d;
    margin-top: 0.55rem; min-height: 1em; opacity: 0; transition: opacity 0.2s;
  }
  .share-toast.visible { opacity: 1; }
</style>
